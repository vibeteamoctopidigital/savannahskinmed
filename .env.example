# Copy this file to .env and fill in your real PostgreSQL connection string.
# Until DATABASE_URL is set (or the database is unreachable), the site falls
# back to the content already baked into lib/site.ts and lib/specialsData.ts,
# and /admin falls back to the seeded admin@gmail.com / admin123 credentials.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
